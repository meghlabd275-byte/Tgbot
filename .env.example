# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_here

# Database Configuration
# Leave as sqlite:///bot.db to use local SQLite, OR configure Supabase below
# to use managed PostgreSQL. When Supabase is configured it takes priority.
DATABASE_URL=sqlite:///bot.db

# Admin Configuration
SUPER_ADMIN_ID=your_telegram_user_id_here

# Logging
LOG_LEVEL=INFO

# ====================================================================
# Supabase Configuration (optional but recommended for production)
# ====================================================================
# Get these from your Supabase project dashboard:
#   Settings > API          -> URL, anon key, service_role key
#   Settings > Database     -> Connection info (host, port, db, user, password)
#
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Anon/public API key
SUPABASE_KEY=
# Service-role key (server-side only; bypasses RLS). Optional.
SUPABASE_SERVICE_KEY=

# --- Option A: full PostgreSQL connection string (preferred) ---
# Found in Supabase: Settings > Database > Connection string > URI
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.abcdefgh.supabase.co:5432/postgres
SUPABASE_DB_URL=

# --- Option B: connection components (used if SUPABASE_DB_URL is empty) ---
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Connection pool tuning (Supabase free tier allows up to 60 direct connections)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
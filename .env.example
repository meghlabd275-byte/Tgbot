# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_here

# Database Configuration
# SQLite by default. Set DATABASE_URL to a PostgreSQL or MySQL URL to use
# a production database. All backends are supported:
#   SQLite:     sqlite:///bot.db
#   PostgreSQL: postgresql+psycopg://user:pass@host:5432/dbname
#   MySQL:      mysql+pymysql://user:pass@host:3306/dbname
DATABASE_URL=sqlite:///bot.db

# Admin Configuration
# SUPER_ADMIN_ID is the bot owner (one Telegram user ID, or comma/space separated).
SUPER_ADMIN_ID=your_telegram_user_id_here
# Optional additional bot owners:
EXTRA_SUPER_ADMIN_IDS=

# Warning / moderation defaults
MAX_WARNINGS=3
DEFAULT_MUTE_TIME=3600
PURGE_LIMIT=100

# Logging
LOG_LEVEL=INFO
